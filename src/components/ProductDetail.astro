---
/*
 * ProductDetail — full product content: intro, specs, features, body, FAQ, downloads.
 * Used by the product page and by single-member family pages (collapsed view).
 */
import { toHTML } from '@portabletext/to-html';
import Section from './Section.astro';

interface Props {
  product: any;
}

const { product } = Astro.props;
const introHtml = product.intro ? toHTML(product.intro as any) : '';
const bodyHtml = product.body ? toHTML(product.body as any) : '';
---

<Section surface="paper">
  {introHtml && (
    <div class="intro-block">
      <div class="eyebrow">Das System</div>
      <div class="intro" set:html={introHtml} />
    </div>
  )}

  {product.specs && product.specs.length > 0 && (
    <div class="specs">
      <h2>Technische Daten</h2>
      <dl class="spec-list">
        {product.specs.map((s: any) => (
          <div class="spec-row">
            <dt>{s.label}</dt>
            <dd>
              {s.value}
              {s.unit && <span class="unit"> {s.unit}</span>}
              {s.notes && <span class="notes"> · {s.notes}</span>}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  )}
</Section>

<Section surface="clay">
  {product.keyFeatures && product.keyFeatures.length > 0 && (
    <div class="features">
      <h2>Merkmale</h2>
      <ul class="feature-list">
        {product.keyFeatures.map((f: any) => (
          <li>
            <h3>{f.title}</h3>
            {f.description && <p>{f.description}</p>}
          </li>
        ))}
      </ul>
    </div>
  )}

  {bodyHtml && <div class="product-body" set:html={bodyHtml} />}
</Section>

{(product.faq?.length > 0 || product.downloads?.length > 0) && (
  <Section surface="paper">
    {product.faq && product.faq.length > 0 && (
      <div class="faq">
        <h2>Häufige Fragen</h2>
        {product.faq.map((q: any) => (
          <details class="faq-item">
            <summary>{q.question}</summary>
            <p>{q.answer}</p>
          </details>
        ))}
      </div>
    )}

    {product.downloads && product.downloads.length > 0 && (
      <div class="downloads">
        <h2>Downloads</h2>
        <ul>
          {product.downloads.map((d: any) => (
            <li>
              <a href={d.file?.asset?.url ?? '#'}>
                {d.title}
                {d.fileType && <span class="type"> · {d.fileType.toUpperCase()}</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </Section>
)}

<style>
  /* ── intro: first paragraph reads as a lede, rest as body ── */
  .intro-block { max-width: 720px; margin-bottom: var(--space-10); }
  .intro :global(p) {
    font-size: 16px;
    line-height: 1.7;
    color: var(--color-muted);
    margin-bottom: var(--space-4);
    max-width: 65ch;
  }
  .intro :global(p:first-of-type) {
    font-size: 20px;
    line-height: 1.55;
    color: var(--color-text);
  }
  .intro :global(strong) { color: var(--color-text); }

  h2 {
    font-family: var(--font-heading);
    font-size: var(--font-size-h2-section);
    font-weight: 500;
    margin: var(--space-10) 0 var(--space-4);
  }
  .specs h2,
  .features h2,
  .faq h2 { margin-top: 0; }
  .spec-list {
    border-top: 1px solid var(--color-border);
  }
  .spec-row {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 32px;
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
    align-items: baseline;
  }
  .spec-row dt {
    font-family: var(--font-mono);
    font-size: var(--font-size-eyebrow);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-muted);
    padding-top: 2px;
  }
  .spec-row dd {
    font-size: 16px;
    font-weight: 500;
    color: var(--color-text);
  }
  .spec-row .unit { color: var(--color-muted); font-weight: 400; font-size: 14px; }
  .spec-row .notes { color: var(--color-muted); font-size: 13px; font-weight: 400; }
  .feature-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
    list-style: none;
    padding: 0;
    counter-reset: feature-counter;
  }
  .feature-list li {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-top: 2px solid var(--color-accent);
    border-radius: var(--radius-lg);
    padding: 28px 24px 24px;
    counter-increment: feature-counter;
    position: relative;
  }
  .feature-list li::before {
    content: counter(feature-counter, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: var(--font-size-eyebrow);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    color: var(--color-accent);
    display: block;
    margin-bottom: var(--space-3);
  }
  .feature-list h3 {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 500;
    margin-bottom: var(--space-2);
    line-height: 1.15;
  }
  .feature-list p {
    font-size: 14px;
    color: var(--color-muted);
    line-height: 1.6;
  }
  .product-body :global(p) { max-width: 65ch; line-height: 1.7; margin-bottom: var(--space-4); }
  .faq-item {
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-4) 0;
  }
  .faq-item summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item p {
    margin-top: var(--space-3);
    color: var(--color-muted);
    line-height: 1.65;
    max-width: 65ch;
  }
  .downloads { margin-top: var(--space-10); }
  .downloads ul { list-style: none; padding: 0; }
  .downloads li { padding: var(--space-2) 0; border-bottom: 1px solid var(--color-border); }
  .downloads a { color: var(--color-text); font-weight: 500; }
  .downloads .type { color: var(--color-muted); font-family: var(--font-mono); font-size: 12px; }
  @media (max-width: 768px) {
    .spec-row { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
