---
import { getAllIndustries, type Locale, type SiteSettings } from '../sanity/queries';

interface Props {
  settings: SiteSettings;
  locale: Locale;
}

const { settings, locale } = Astro.props;

const allIndustries = await getAllIndustries(locale);
const footerIndustries = allIndustries.slice(0, 4);
const industryBase = '/branchen';

const labels = locale === 'de'
  ? {
      products: 'Produkte',
      industries: 'Branchen',
      company: 'Unternehmen',
      legal: 'Impressum',
      privacy: 'Datenschutz',
      cookies: 'Cookie-Einstellungen',
      cookiePolicy: 'Cookie-Richtlinie',
      downloads: 'Downloads',
      about: 'Unternehmen',
      careers: 'Karriere',
      contact: 'Kontakt',
    }
  : {
      products: 'Products',
      industries: 'Industries',
      company: 'Company',
      legal: 'Legal Notice',
      privacy: 'Privacy Policy',
      cookies: 'Cookie Settings',
      cookiePolicy: 'Cookie Policy',
      downloads: 'Downloads',
      about: 'About',
      careers: 'Careers',
      contact: 'Contact',
    };

const description = locale === 'de'
  ? 'Schienengeführte Fördersysteme für Präzisionsmontage in Automobil- und Industriefertigung. Engineered in Deutschland seit 1985.'
  : 'Rail-guided conveyor systems for precision automotive and industrial assembly. Engineered in Germany since 1985.';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="brand-name">KRUPS <span>Automation</span></div>
        <p>{description}</p>
        <address>
          KRUPS Automation GmbH<br />
          Ringstr. 13 · 56307 Dernbach<br />
          +49 2689 9435-0
        </address>
      </div>

      <div class="footer-col">
        <h3>{labels.products}</h3>
        <ul>
          <li><a href="/produkte/ecart">LOGO!MAT eCart</a></li>
          <li><a href="/produkte/friktionsrollenfoerderer">Friktionsförderer L</a></li>
          <li><a href="/produkte/friktionsrollenfoerderer">Friktionsförderer XL</a></li>
          <li><a href="/produkte/friktionsrollenfoerderer">T-Serie</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h3>{labels.industries}</h3>
        <ul>
          {footerIndustries.map((industry) => (
            <li><a href={`${industryBase}/${industry.slug.current}`}>{industry.name}</a></li>
          ))}
        </ul>
      </div>

      <div class="footer-col">
        <h3>{labels.company}</h3>
        <ul>
          <li><a href="/unternehmen">{labels.about}</a></li>
          <li><a href="/downloads">{labels.downloads}</a></li>
          <li><a href="https://krups-group.com/karriere" target="_blank" rel="noopener">{labels.careers}</a></li>
          <li><a href="https://www.linkedin.com/company/krups-automation" target="_blank" rel="noopener">LinkedIn</a></li>
          <li><a href="/kontakt">{labels.contact}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span class="copy">{settings.footerCopyright ?? '© 2026 KRUPS Automation GmbH'}</span>
      <div class="bottom-links">
        <a href="/impressum">{labels.legal}</a>
        <a href="/datenschutz">{labels.privacy}</a>
        <a href="/cookie-richtlinien">{labels.cookiePolicy}</a>
        <a href="#cookie-einstellungen">{labels.cookies}</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-dark-bg);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    padding: 56px 0 var(--space-10);
    color: var(--color-dark-text);
  }

  .container {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 var(--content-gutter);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    gap: var(--space-12);
    margin-bottom: 56px;
  }

  .brand-name {
    font-family: var(--font-body);
    font-size: var(--font-size-body-sm);
    font-weight: 700;
    color: var(--color-dark-text);
    margin-bottom: var(--space-2);
  }

  .brand-name span {
    color: var(--color-accent);
  }

  .footer-brand p {
    font-size: var(--font-size-label);
    color: var(--color-dark-muted);
    line-height: 1.65;
    max-width: 260px;
    margin-bottom: var(--space-4);
  }

  .footer-brand address {
    font-style: normal;
    font-family: var(--font-mono);
    font-size: var(--font-size-eyebrow);
    color: var(--color-dark-muted);
    line-height: 1.9;
  }

  .footer-col h3 {
    font-family: var(--font-body);
    font-size: var(--font-size-eyebrow);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--color-dark-muted);
    margin-bottom: var(--space-4);
  }

  .footer-col ul {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .footer-col ul a {
    font-size: var(--font-size-label);
    color: var(--color-dark-muted);
    padding: 6px 0;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    transition: color var(--duration-short);
  }

  .footer-col ul a:hover,
  .footer-col ul a:focus-visible {
    color: var(--color-dark-text);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: var(--space-8);
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .copy {
    font-family: var(--font-mono);
    font-size: var(--font-size-eyebrow);
    color: var(--color-dark-muted);
  }

  .bottom-links {
    display: flex;
    gap: var(--space-6);
  }

  .bottom-links a {
    font-size: var(--font-size-label);
    color: var(--color-dark-muted);
    transition: color var(--duration-short);
  }

  .bottom-links a:hover,
  .bottom-links a:focus-visible {
    color: var(--color-dark-text);
  }

  @media (max-width: 900px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .container {
      padding: 0 var(--space-6);
    }

    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
