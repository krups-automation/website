---
/*
 * PageHero — full-bleed charcoal hero band for inner pages.
 * Breadcrumbs + eyebrow + H1 + lede, optional right-aligned Sanity image.
 */
import Breadcrumbs from './Breadcrumbs.astro';
import SanityImage from './SanityImage.astro';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  breadcrumbs: Crumb[];
  title: string;
  eyebrow?: string;
  lede?: string;
  image?: unknown;
  imageAlt?: string;
}

const { breadcrumbs, title, eyebrow, lede, image, imageAlt } = Astro.props;
---

<section class="page-hero">
  <div class="page-hero-inner">
    <Breadcrumbs items={breadcrumbs} />
    <div class="page-hero-text">
      {eyebrow && <div class="eyebrow">{eyebrow}</div>}
      <h1>{title}</h1>
      {lede && <p class="lede hero-lede">{lede}</p>}
      <slot />
    </div>
  </div>
  {image && (
    <div class="page-hero-img">
      <SanityImage
        source={image}
        alt={imageAlt ?? title}
        width={800}
        loading="eager"
        fetchpriority="high"
        sizes="45vw"
        class="hero-photo"
      />
    </div>
  )}
</section>

<style>
  .page-hero {
    position: relative;
    min-height: 480px;
    background: var(--color-dark-bg);
    overflow: hidden;
  }

  .page-hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
    padding: calc(var(--nav-height) + var(--space-16)) var(--space-16) var(--space-16);
    min-height: 480px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .page-hero-inner :global(.breadcrumbs ol) { color: var(--color-dark-muted); }
  .page-hero-inner :global(.breadcrumbs a) { color: var(--color-dark-muted); }
  .page-hero-inner :global(.breadcrumbs a:hover) { color: var(--color-dark-text); }
  .page-hero-inner :global(.breadcrumbs [aria-current='page']) { color: var(--color-dark-text); }

  .page-hero-text {
    max-width: 55%;
    margin-top: var(--space-5);
  }

  .page-hero-text h1 {
    font-size: var(--font-size-h1);
    line-height: var(--line-height-h1);
    color: var(--color-dark-text);
    margin-bottom: var(--space-4);
  }

  .hero-lede {
    color: var(--color-dark-muted);
    max-width: 46ch;
  }

  .page-hero-img {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 45%;
    z-index: 1;
  }

  .page-hero-img::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(90deg, var(--color-dark-bg) 0%, rgba(28, 28, 26, 0.5) 50%, rgba(28, 28, 26, 0) 100%);
  }

  .page-hero-img :global(.hero-photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 768px) {
    .page-hero { min-height: unset; }
    .page-hero-inner {
      min-height: unset;
      padding: calc(var(--nav-height) + var(--space-8)) var(--space-6) var(--space-8);
    }
    .page-hero-text { max-width: 100%; }
    .page-hero-img { position: static; width: 100%; height: 240px; }
    .page-hero-img::before {
      background: linear-gradient(180deg, rgba(28, 28, 26, 0.4) 0%, rgba(28, 28, 26, 0) 60%);
    }
  }
</style>
