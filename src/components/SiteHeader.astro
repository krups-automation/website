---
import type { Locale, SiteSettings } from '../sanity/queries';

interface Props {
  settings: SiteSettings;
  locale: Locale;
  currentPath: string;
}

const { settings, locale, currentPath } = Astro.props;
const otherLocale: Locale = locale === 'de' ? 'en' : 'de';
const otherLocaleLabel = otherLocale.toUpperCase();
const currentLocaleLabel = locale.toUpperCase();

// Path-based locale swap. If current has `/en/` prefix, strip it. Otherwise prepend.
// Translation mapping (if slug differs across locales) is a Phase 2 concern.
function swapLocale(path: string, from: Locale, to: Locale): string {
  if (from === 'en' && path.startsWith('/en/')) {
    const stripped = path.replace(/^\/en/, '') || '/';
    return stripped;
  }
  if (from === 'en' && path === '/en') return '/';
  if (from === 'de' && to === 'en') {
    if (path === '/') return '/en/';
    return `/en${path.startsWith('/') ? path : `/${path}`}`;
  }
  return path;
}

const otherLocaleHref = swapLocale(currentPath, locale, otherLocale);
const homeHref = locale === 'en' ? '/en/' : '/';
---

<header class="site-header" aria-label="Primary">
  <!-- checkbox powers the CSS-only mobile drawer toggle -->
  <input type="checkbox" id="nav-toggle" class="nav-toggle-input" aria-hidden="true" />

  <div class="header-inner">
    <a href={homeHref} class="brand">
      KRUPS <span>Automation</span>
    </a>

    {settings.primaryNav && settings.primaryNav.length > 0 && (
      <nav class="nav-links" aria-label="Main navigation">
        <ul>
          {settings.primaryNav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    )}

    <div class="nav-right">
      <a href={otherLocaleHref} class="lang-switch" aria-label={`Switch to ${otherLocale === 'de' ? 'German' : 'English'}`}>
        <span class="current">{currentLocaleLabel}</span>
        <span class="sep">/</span>
        <span class="other">{otherLocaleLabel}</span>
      </a>

      {settings.ctaLabel && settings.ctaHref && (
        <a href={settings.ctaHref} class="cta">{settings.ctaLabel}</a>
      )}

      <label for="nav-toggle" class="burger" aria-label="Navigation öffnen">
        <span></span><span></span><span></span>
      </label>
    </div>
  </div>

  <!-- Mobile drawer — only visible when checkbox is checked -->
  <nav class="nav-drawer" aria-label="Mobile navigation">
    <ul class="drawer-links">
      {settings.primaryNav?.map((item) => (
        <li><a href={item.href}>{item.label}</a></li>
      ))}
    </ul>
    {settings.ctaLabel && settings.ctaHref && (
      <a href={settings.ctaHref} class="drawer-cta">{settings.ctaLabel}</a>
    )}
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 200;
    background: rgba(242, 239, 234, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    transition: background var(--duration-medium) ease, border-color var(--duration-medium) ease, backdrop-filter var(--duration-medium) ease;
  }

  /* Transparent state — used on hero pages only (added via JS) */
  .site-header.is-transparent {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom-color: transparent;
  }
  .site-header.is-transparent .brand { color: var(--color-dark-text); }
  .site-header.is-transparent .brand span { color: var(--color-accent); }
  .site-header.is-transparent .nav-links a { color: var(--color-dark-muted); }
  .site-header.is-transparent .nav-links a:hover,
  .site-header.is-transparent .nav-links a:focus-visible {
    color: var(--color-dark-text);
    background: rgba(255, 255, 255, 0.06);
  }
  .site-header.is-transparent .lang-switch { color: var(--color-dark-muted); }
  .site-header.is-transparent .lang-switch .current { color: var(--color-dark-text); }
  .site-header.is-transparent .lang-switch:hover .other { color: var(--color-dark-text); }
  .site-header.is-transparent .cta {
    background: var(--color-accent);
    color: var(--color-text);
  }
  .site-header.is-transparent .cta:hover { background: var(--color-accent-hover); }
  .site-header.is-transparent .burger span { background: var(--color-dark-text); }

  /* Hidden checkbox — controls drawer state */
  .nav-toggle-input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
    overflow: hidden;
  }

  .header-inner {
    padding: 0 var(--space-12);
    height: var(--nav-height);
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
  }

  .brand {
    font-family: var(--font-body);
    font-size: var(--font-size-body-sm);
    font-weight: 700;
    color: var(--color-text);
    white-space: nowrap;
  }

  .brand span { color: var(--color-accent); }

  .nav-links ul {
    display: flex;
    gap: 2px;
    justify-content: center;
  }

  .nav-links a {
    font-size: var(--font-size-body-sm);
    font-weight: 500;
    color: var(--color-muted);
    padding: 6px 14px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    border-radius: var(--radius-md);
    transition: color var(--duration-short), background var(--duration-short);
  }

  .nav-links a:hover,
  .nav-links a:focus-visible {
    color: var(--color-text);
    background: rgba(26, 26, 24, 0.06);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 10px;
    justify-content: flex-end;
  }

  .lang-switch {
    font-family: var(--font-mono);
    font-size: var(--font-size-eyebrow);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    color: var(--color-muted);
    padding: 6px var(--space-1);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }

  .lang-switch .current { color: var(--color-text); }
  .lang-switch .sep { opacity: 0.5; }
  .lang-switch:hover .other { color: var(--color-text); }

  .cta {
    background: var(--color-text);
    color: var(--color-bg);
    padding: var(--space-2) 22px;
    border-radius: var(--radius-md);
    font-size: var(--font-size-specs);
    font-weight: 600;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    transition: background var(--duration-short);
  }

  .cta:hover,
  .cta:focus-visible { background: var(--color-dark-bg); }

  /* Hamburger button */
  .burger {
    display: none;
    cursor: pointer;
    padding: var(--space-2);
    margin-left: var(--space-1);
    flex-direction: column;
    gap: 5px;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
  }

  .burger span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--color-text);
    border-radius: 1px;
    transition: transform var(--duration-short) ease, opacity var(--duration-short) ease;
  }

  /* Burger animates to × when drawer is open */
  .nav-toggle-input:checked ~ .header-inner .burger span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  .nav-toggle-input:checked ~ .header-inner .burger span:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .nav-toggle-input:checked ~ .header-inner .burger span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* Mobile drawer */
  .nav-drawer {
    display: none;
    padding: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .nav-toggle-input:checked ~ .nav-drawer {
    display: block;
  }

  .drawer-links {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-6);
  }

  .drawer-links a {
    display: block;
    padding: 14px 0;
    font-size: var(--font-size-body);
    font-weight: 500;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
    transition: color var(--duration-short);
  }

  .drawer-links a:hover { color: var(--color-accent); }

  .drawer-cta {
    display: inline-flex;
    background: var(--color-text);
    color: var(--color-bg);
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    font-size: var(--font-size-specs);
    font-weight: 600;
    transition: background var(--duration-short);
  }

  .drawer-cta:hover { background: var(--color-dark-bg); }

  @media (max-width: 900px) {
    .header-inner { padding: 0 var(--space-6); }
    .nav-links { display: none; }
    .cta { display: none; }
    .burger { display: flex; }
  }
</style>

<script>
  const header = document.querySelector('.site-header') as HTMLElement | null;
  const heroEl = document.querySelector('.hero');

  if (heroEl && header) {
    header.classList.add('is-transparent');

    const onScroll = () => {
      if (window.scrollY > 24) {
        header.classList.remove('is-transparent');
      } else {
        header.classList.add('is-transparent');
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
