---
import { toHTML } from '@portabletext/to-html';
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SanityImage from '../components/SanityImage.astro';
import { getPlanService } from '../sanity/queries';
import { serviceSchema, faqSchema } from '../lib/schema-org';

const service = await getPlanService('de');
const bodyHtml = service?.body ? toHTML(service.body as any) : '';

const jsonLd = [
  serviceSchema({
    name: service?.name ?? 'Produktionsplanung',
    description: service?.metaDescription ?? service?.summary,
    url: '/planung',
  }),
  ...(service?.faq && service.faq.length > 0 ? [faqSchema(service.faq)] : []),
];
---

<BaseLayout
  title={service?.metaTitle ?? 'Produktionsplanung — KRUPS Automation'}
  description={service?.metaDescription ?? 'Produktionsplanung für Montagelinien: Layout, Takt, Materialfluss, Payload-Profile.'}
  locale="de"
  breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Planung' }]}
  jsonLd={jsonLd}
>
  <section class="page-hero">
    <div class="page-hero-inner">
      <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Planung' }]} />
      <div class="page-hero-text">
        <div class="eyebrow">Plan</div>
        <h1>{service?.name ?? 'Produktionsplanung'}</h1>
        {service?.summary && <p class="hero-lede">{service.summary}</p>}
        {!service && (
          <p class="hero-lede">
            Wir planen Montagelinien von der Skizze bis zum Lastenheft: Layout,
            Takt, Materialfluss und Payload-Profile. Bevor die erste Schiene gebogen wird.
          </p>
        )}
      </div>
    </div>
    {service?.heroImage && (
      <div class="page-hero-img">
        <SanityImage
          source={service.heroImage}
          alt={service.name}
          width={800}
          loading="eager"
          fetchpriority="high"
          sizes="45vw"
          class="hero-photo"
        />
      </div>
    )}
  </section>

  <Section surface="clay">
    {service?.processSteps && service.processSteps.length > 0 && (
      <div class="steps">
        <h2>Vorgehen</h2>
        <ol class="step-list">
          {service.processSteps.map((s) => (
            <li>
              <span class="step-num">{s.stepNumber ?? ''}</span>
              <div>
                <h3>{s.title}</h3>
                {s.description && <p>{s.description}</p>}
              </div>
            </li>
          ))}
        </ol>
      </div>
    )}

    {service?.deliverables && service.deliverables.length > 0 && (
      <div class="deliverables">
        <h2>Ergebnisse</h2>
        <ul>
          {service.deliverables.map((d) => <li>{d}</li>)}
        </ul>
      </div>
    )}

    {bodyHtml && <div class="service-body" set:html={bodyHtml} />}

    {!service && (
      <div class="empty-state">
        <p>
          Wir bereiten die Detailseite gerade vor. Schreiben Sie uns an
          <a href="/kontakt"> kontakt</a> — wir besprechen Ihr Projekt gerne persönlich.
        </p>
      </div>
    )}
  </Section>

  {service?.faq && service.faq.length > 0 && (
    <Section surface="paper">
      <div class="faq">
        <h2>Häufige Fragen</h2>
        {service.faq.map((q) => (
          <details class="faq-item">
            <summary>{q.question}</summary>
            <p>{q.answer}</p>
          </details>
        ))}
      </div>
    </Section>
  )}
</BaseLayout>

<style>
  /* ── page hero ── */
  .page-hero {
    position: relative;
    min-height: 480px;
    background: var(--color-dark-bg);
    overflow: hidden;
  }
  .page-hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
    padding: calc(var(--nav-height) + var(--space-16)) var(--space-16) var(--space-16);
    min-height: 480px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .page-hero-inner :global(.breadcrumbs ol) { color: var(--color-dark-muted); }
  .page-hero-inner :global(.breadcrumbs a) { color: var(--color-dark-muted); }
  .page-hero-inner :global(.breadcrumbs a:hover) { color: var(--color-dark-text); }
  .page-hero-inner :global(.breadcrumbs [aria-current='page']) { color: var(--color-dark-text); }
  .page-hero-text { max-width: 55%; margin-top: var(--space-5); }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-4);
  }
  .page-hero-text h1 {
    font-family: var(--font-heading);
    font-size: clamp(40px, 4.5vw, 64px);
    font-weight: 600;
    line-height: 1.02;
    color: var(--color-dark-text);
    margin-bottom: var(--space-4);
  }
  .hero-lede {
    font-size: 17px;
    color: var(--color-dark-muted);
    line-height: 1.6;
    max-width: 46ch;
  }
  .page-hero-img {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 45%;
    z-index: 1;
  }
  .page-hero-img::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(90deg, var(--color-dark-bg) 0%, rgba(28,28,26,0.5) 50%, rgba(28,28,26,0) 100%);
  }
  .page-hero-img :global(.hero-photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  @media (max-width: 768px) {
    .page-hero { min-height: unset; }
    .page-hero-inner { min-height: unset; padding: calc(var(--nav-height) + var(--space-8)) var(--space-6) var(--space-8); }
    .page-hero-text { max-width: 100%; }
    .page-hero-img { position: static; width: 100%; height: 240px; }
    .page-hero-img::before { background: linear-gradient(180deg, rgba(28,28,26,0.4) 0%, rgba(28,28,26,0) 60%); }
  }
  .steps h2,
  .deliverables h2,
  .faq h2 {
    font-family: var(--font-heading);
    font-size: var(--font-size-h2-section);
    font-weight: 500;
    margin: 0 0 var(--space-6);
  }
  .deliverables { margin-top: var(--space-12); }
  .step-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  .step-list li {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 24px;
    padding: 24px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .step-num {
    font-family: var(--font-heading);
    font-size: 32px;
    font-weight: 300;
    color: var(--color-accent);
    line-height: 1;
  }
  .step-list h3 {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 500;
    margin-bottom: var(--space-2);
  }
  .step-list p {
    font-size: 14px;
    color: var(--color-muted);
    line-height: 1.6;
  }
  .deliverables ul {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 12px;
  }
  .deliverables li {
    padding: 16px 20px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: 14px;
  }
  .service-body :global(p) { max-width: 65ch; line-height: 1.7; margin-bottom: var(--space-4); }
  .faq-item {
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-4) 0;
  }
  .faq-item summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item p { margin-top: var(--space-3); color: var(--color-muted); line-height: 1.65; max-width: 65ch; }
  .empty-state {
    padding: 48px;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-muted);
  }
  .empty-state a { color: var(--color-text); text-decoration: underline; text-decoration-color: var(--color-accent); text-underline-offset: 4px; }
</style>
