---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="KRUPS Automation — LOGO!MAT eCart" locale="de">
  <!-- ════ 1. HERO ════ -->
  <section class="hero">
    <div class="hero-fade"></div>
    <div class="hero-content">
      <div class="hero-eyebrow">LOGO!MAT eCart — Entwickelt und gefertigt in Dernbach</div>
      <h1>Gebaut für <em>die Linie,</em> die niemals stoppt.</h1>
      <p class="hero-sub">
        Schienengeführte Fördersysteme für die Präzisionsmontage —
        von Batteriemodulen bis Antriebsstrang, bewährt bei den führenden Herstellern weltweit.
      </p>
      <div class="hero-ctas">
        <a href="#systems" class="btn btn-accent">Unsere Systeme →</a>
        <a href="/kontakt" class="btn btn-ghost-light">Experten kontaktieren</a>
      </div>
      <div class="hero-stats">
        <div class="hero-stat"><span class="val">500+</span><span class="lbl">Anlagen</span></div>
        <div class="hero-stat-sep"></div>
        <div class="hero-stat"><span class="val">300 – 2.000 kg</span><span class="lbl">Traglastbereich</span></div>
        <div class="hero-stat-sep"></div>
        <div class="hero-stat"><span class="val">±0,1 mm</span><span class="lbl">Positionsgenauigkeit</span></div>
        <div class="hero-stat-sep"></div>
        <div class="hero-stat"><span class="val">40+</span><span class="lbl">Jahre</span></div>
      </div>
    </div>
  </section>

  <!-- ════ 2. TRUST BAR ════ -->
  <div class="trust-bar">
    <div class="trust-bar-inner">
      <span class="trust-bar-label">Referenzkunden</span>
      <div class="trust-sep"></div>
      <div class="trust-logos">
        <span class="trust-logo">BMW</span>
        <span class="trust-logo">Volkswagen</span>
        <span class="trust-logo">Tesla</span>
        <span class="trust-logo">Ford</span>
        <span class="trust-logo">ŠKODA</span>
        <span class="trust-logo">ZF</span>
        <span class="trust-logo">Eaton</span>
      </div>
    </div>
  </div>

  <!-- ════ 3. PROOF STATS ════ -->
  <section class="proof-alt">
    <div class="container">
      <div class="proof-alt-strip">
        <div class="proof-alt-item">
          <span class="proof-alt-num">500+</span>
          <span class="proof-alt-label">Anlagen weltweit<br>im Einsatz</span>
        </div>
        <div class="proof-alt-item">
          <span class="proof-alt-num">40+</span>
          <span class="proof-alt-label">Jahre Entwicklungs-<br>erfahrung</span>
        </div>
        <div class="proof-alt-item">
          <span class="proof-alt-num">2.000 kg</span>
          <span class="proof-alt-label">Maximale<br>Traglast</span>
        </div>
        <div class="proof-alt-item">
          <span class="proof-alt-num">14</span>
          <span class="proof-alt-label">Länder mit<br>aktiven Anlagen</span>
        </div>
      </div>

      <div class="proof-alt-bottom">
        <h2 class="proof-headline">Vierzig Jahre Montagelinientechnik.</h2>
        <p class="proof-body">
          Seit 1985 entwickelt, fertigt und nimmt KRUPS Automation Fördersysteme
          für die anspruchsvollsten Montageumgebungen in der Automobil- und
          Industrieproduktion in Betrieb.
        </p>
        <a href="/unternehmen" class="btn btn-ghost">Über das Unternehmen <span class="card-arrow">→</span></a>
      </div>
    </div>
  </section>

  <!-- ════ 4. PRODUCTS ════ -->
  <section class="products" id="systems">
    <div class="container">
      <div class="products-header">
        <div>
          <div class="products-eyebrow">Produktsysteme</div>
          <h2>Zwei Plattformen.<br>Jede Montageaufgabe.</h2>
        </div>
        <p class="products-header-right">
          Von leichten Bauteilen bis zu schweren Batteriepaketen —
          ein komplettes Förderanlagenprogramm aus einer Hand.
        </p>
      </div>

      <div class="products-grid">
        <a class="product-card featured" href="/produkte/ecart">
          <div class="card-tag">Flaggschiff</div>
          <h3>LOGO!MAT eCart</h3>
          <p>
            Elektrisch angetriebene, schienengeführte Werkstückträger für die
            Präzisionsmontageautomation. Jeder Werkstückträger trägt seinen
            eigenen Antrieb, seine Steuerung und Energieversorgung — ohne
            zentrale Antriebsketten.
          </p>
          <div class="card-specs">
            <span class="spec-chip">300 – 2.000 kg</span>
            <span class="spec-chip">±0,1 mm</span>
            <span class="spec-chip">ESD-sicher</span>
            <span class="spec-chip">Kein WLAN</span>
            <span class="spec-chip">Aktive Bremse</span>
          </div>
          <div class="card-visual">
            <svg class="card-track-svg" viewBox="0 0 600 260" fill="none" xmlns="http://www.w3.org/2000/svg">
              <line x1="40" y1="76" x2="560" y2="76" stroke="#E8B500" stroke-width="1.5"/>
              <line x1="40" y1="184" x2="560" y2="184" stroke="#E8B500" stroke-width="1.5"/>
              <rect x="78" y="96" width="104" height="72" rx="5" stroke="#1A1A18" stroke-width="1.5" fill="none"/>
              <rect x="83" y="101" width="94" height="62" rx="3" stroke="#8A8680" stroke-width="1" fill="none"/>
              <circle cx="98" cy="184" r="7" stroke="#E8B500" stroke-width="1.5" fill="none"/>
              <circle cx="164" cy="184" r="7" stroke="#E8B500" stroke-width="1.5" fill="none"/>
              <rect x="244" y="96" width="104" height="72" rx="5" stroke="#1A1A18" stroke-width="1.5" fill="none"/>
              <rect x="249" y="101" width="94" height="62" rx="3" stroke="#8A8680" stroke-width="1" fill="none"/>
              <circle cx="264" cy="184" r="7" stroke="#E8B500" stroke-width="1.5" fill="none"/>
              <circle cx="330" cy="184" r="7" stroke="#E8B500" stroke-width="1.5" fill="none"/>
              <rect x="410" y="96" width="104" height="72" rx="5" stroke="#1A1A18" stroke-width="1.5" fill="none"/>
              <rect x="415" y="101" width="94" height="62" rx="3" stroke="#8A8680" stroke-width="1" fill="none"/>
              <circle cx="430" cy="184" r="7" stroke="#E8B500" stroke-width="1.5" fill="none"/>
              <circle cx="496" cy="184" r="7" stroke="#E8B500" stroke-width="1.5" fill="none"/>
              <line x1="204" y1="64" x2="204" y2="196" stroke="#8A8680" stroke-width="1" stroke-dasharray="3 4"/>
              <line x1="370" y1="64" x2="370" y2="196" stroke="#8A8680" stroke-width="1" stroke-dasharray="3 4"/>
              <path d="M544 130 L558 130 L551 123 M558 130 L551 137" stroke="#E8B500" stroke-width="1.5" stroke-linecap="round"/>
              <text x="204" y="56" text-anchor="middle" font-family="JetBrains Mono, ui-monospace, 'Courier New', monospace" font-size="9" fill="#8A8680" letter-spacing="0.5">STA 01</text>
              <text x="370" y="56" text-anchor="middle" font-family="JetBrains Mono, ui-monospace, 'Courier New', monospace" font-size="9" fill="#8A8680" letter-spacing="0.5">STA 02</text>
            </svg>
            <span class="card-visual-label">eCart V3 — Rail system schematic</span>
          </div>
          <span class="card-link">LOGO!MAT eCart entdecken <span class="card-arrow">→</span></span>
        </a>

        <a class="product-card" href="/produkte/friktionsrollenfoerderer">
          <div class="card-tag">Bewährte Plattform</div>
          <h3>Friktionsrollen&shy;förderer</h3>
          <p>
            Friktionsrollenförderer für den kontinuierlichen Materialfluss in
            Montage- und Prüflinien. Einfach, robust, über Jahrzehnte bewährt.
            Verfügbar als L-, XL- und T-Serie.
          </p>
          <div class="card-specs">
            <span class="spec-chip">50 – 600 kg</span>
            <span class="spec-chip">L / XL / T-Serie</span>
            <span class="spec-chip">Ölbeständig</span>
          </div>
          <span class="card-link">Friktionsförderer entdecken <span class="card-arrow">→</span></span>
        </a>

        <a class="product-card" href="/kontakt">
          <div class="card-tag">Sonderlösungen</div>
          <h3>Sonder&shy;entwicklungen</h3>
          <p>
            Wenn Standardsysteme nicht passen — wir entwickeln von Grund auf neu.
            100 % Eigenfertigung bedeutet: jede Sonderanforderung wird mit voller
            KRUPS-Qualität und -Betreuung realisiert.
          </p>
          <div class="card-specs">
            <span class="spec-chip">Projektspezifisch</span>
            <span class="spec-chip">Vollständiger Lebenszyklus</span>
          </div>
          <span class="card-link">Projekt besprechen <span class="card-arrow">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- ════ 4b. PLAN · BUILD · RUN ════ -->
  <section class="lifecycle">
    <div class="container">
      <div class="lifecycle-header">
        <div class="lifecycle-eyebrow">Aus einer Hand</div>
        <h2><em>Plan.</em> Build. <em>Run.</em></h2>
        <p class="lifecycle-sub">
          Eine Förderlinie ist eine 15-Jahres-Entscheidung. Wir übernehmen
          Verantwortung für den gesamten Lebenszyklus — vom ersten Linienkonzept
          bis zum Serviceeinsatz ein Jahrzehnt später.
        </p>
      </div>

      <div class="lifecycle-grid">
        <a class="lifecycle-card" href="/planung">
          <div class="lifecycle-step">
            <span class="lifecycle-num">01</span>
            <span class="lifecycle-label">Plan</span>
          </div>
          <h3>Produktions&shy;planung</h3>
          <p>
            Linienlayout, Takt, Materialfluss, Traglastprofile.
            Wir planen das Fertigungskonzept, bevor die erste Schiene gebogen wird.
          </p>
          <span class="lifecycle-link">Planungsleistungen ansehen <span class="card-arrow">→</span></span>
        </a>

        <a class="lifecycle-card" href="/produkte">
          <div class="lifecycle-step">
            <span class="lifecycle-num">02</span>
            <span class="lifecycle-label">Build</span>
          </div>
          <h3>Produkte &amp; Fertigung</h3>
          <p>
            LOGO!MAT eCart und Friktionsrollen — 100 % eigengefertigt in Dernbach.
            Ausgelegt, montiert, inbetriebgenommen vom Team, das sie entwickelt hat.
          </p>
          <span class="lifecycle-link">Portfolio ansehen <span class="card-arrow">→</span></span>
        </a>

        <a class="lifecycle-card" href="/leistungen">
          <div class="lifecycle-step">
            <span class="lifecycle-num">03</span>
            <span class="lifecycle-label">Run</span>
          </div>
          <h3>Leistungen &amp; Service</h3>
          <p>
            Projektierung, Montage, Steuerungsintegration und Langzeit-Service.
            Die Linie läuft — wir halten sie am Laufen.
          </p>
          <span class="lifecycle-link">Leistungen ansehen <span class="card-arrow">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <!-- ════ 5. WHY ════ -->
  <section class="why">
    <div class="container">
      <div class="why-header">
        <h2>Sechs Gründe, warum Werksplaner<br><em>LOGO!MAT</em> spezifizieren.</h2>
        <p class="why-header-right">
          Jede Aussage stammt aus einem Kundenprojektbericht.
          Kein Marketing — Technikentscheidungen von Produktionsplanern,
          die die Zahlen geprüft haben.
        </p>
      </div>

      <div class="why-rows">
        <div class="why-row">
          <div class="why-claim">Inbetriebnahme in Tagen, nicht Wochen.</div>
          <div class="why-detail">UDP-Schnittstellen und vorverkabelte Module reduzieren den Elektroinstallationsaufwand auf einen Bruchteil konventioneller Systeme. <strong>Kunden berichten, dass Montageteams Installationen in Tagen abgeschlossen haben, die die eigenen Ingenieure auf Wochen veranschlagt hatten.</strong></div>
        </div>
        <div class="why-row">
          <div class="why-claim">Aktive Bremse — echte Sicherheit.</div>
          <div class="why-detail">Der Werkstückträger absorbiert kinetische Energie beim Nothalt. Eine Rutschkupplung begrenzt die Antriebskraft — sie stoppt keine bewegte Last. <strong>Der eCart verzögert sicher an der Station, auch wenn der Sicherheitskreis der Station geöffnet ist.</strong></div>
        </div>
        <div class="why-row">
          <div class="why-claim">30 % des Energieverbrauchs konventioneller Systeme.</div>
          <div class="why-detail">Von Kunden in Betriebsanlagen gemessen. Kurze Motorlaufzeiten und kein Dauerkettentrieb machen den Unterschied. <strong>Weniger Laufzeit an beweglichen Teilen bedeutet geringeren Verschleiß und längere Wartungsintervalle.</strong></div>
        </div>
        <div class="why-row">
          <div class="why-claim">Keine WLAN-Abhängigkeit.</div>
          <div class="why-detail">Schienengeführte, kabelgebundene Steuerung eliminiert Übertragungsfehler durch WLAN-Störungen, Bautätigkeit oder benachbarte Netzwerke. <strong>Keine Anlaufverzögerungen nach Notstopps — wie sie WLAN-abhängige AGV-Flotten betreffen.</strong></div>
        </div>
        <div class="why-row">
          <div class="why-claim">±0,1 mm Stoppgenauigkeit, jeden Takt.</div>
          <div class="why-detail">Servoangetriebene Positionierung auf der Schiene mit integrierten Stoppereinheiten. AGVs weichen je nach Bodenebene, Lastverteilung und Ladestand um Millimeter ab. <strong>Eine konstante Stoppposition ist in der Batteriemontage keine Option — sie ist Voraussetzung.</strong></div>
        </div>
        <div class="why-row">
          <div class="why-claim">Umkonfiguriert in Stunden.</div>
          <div class="why-detail">Änderungen am Schienenlayout — Stationen hinzufügen, Wendeschleifen, Liniensplit — erfordern Stunden mechanischer Arbeit und minimale SPS-Umprogrammierung. <strong>Änderungen können im digitalen Zwilling erprobt werden, bevor die laufende Anlage berührt wird.</strong></div>
        </div>
      </div>

      <div class="why-footer">
        <a href="/ressourcen/ecart-vs-agv" class="btn btn-ghost-light">Vollständigen eCart-vs.-AGV-Vergleich lesen →</a>
      </div>
    </div>
  </section>

  <!-- ════ 6. INDUSTRIES ════ -->
  <section class="industries">
    <div class="container">
      <div class="industries-header">
        <h2>Wo KRUPS-Systeme im Einsatz sind.</h2>
        <p class="sub">
          Von der Batteriemodul-Montage im Giga-Maßstab bis zum Präzisions-
          antriebsstrangprüfstand — Lastbereich und Flexibilität des LOGO!MAT
          decken die anspruchsvollsten Anwendungen der Industrie ab.
        </p>
      </div>

      <div class="industry-list">
        <a class="industry-row featured" href="/branchen/batteriemontage">
          <div class="industry-num">01</div>
          <div class="industry-body">
            <h3>E-Mobilität &amp; Batteriemontage</h3>
            <p>Batteriemodule und Batteriepakete für 48-V- bis 800-V-Plattformen. Präzise Positionierung für Zell-zu-Modul- und Modul-zu-Pack-Prozesse, mit ESD-sicherer Werkstückträgerkonstruktion.</p>
          </div>
          <div class="industry-meta">
            <span class="payload">300 – 800 kg</span>
            <span class="clients">BMW · Volkswagen · Tesla</span>
          </div>
        </a>
        <a class="industry-row" href="/branchen/antriebsstrang">
          <div class="industry-num">02</div>
          <div class="industry-body">
            <h3>Automotive Antriebsstrang</h3>
            <p>Motor-, Getriebe- und Achsmontagelinien, bei denen Präzision und Taktzeitkonstanz nicht verhandelbare Produktionsparameter sind.</p>
          </div>
          <div class="industry-meta">
            <span class="payload">200 – 1.500 kg</span>
            <span class="clients">ZF · Ford · Eaton</span>
          </div>
        </a>
        <a class="industry-row" href="/branchen/pruef-testautomation">
          <div class="industry-num">03</div>
          <div class="industry-body">
            <h3>Prüf- &amp; Testautomation</h3>
            <p>Förderintegration mit Prüfständen und Messstationen. Wiederholgenaue Positionierung ist entscheidend für automatisierte Prüfprotokollierung und Rückverfolgbarkeit.</p>
          </div>
          <div class="industry-meta">
            <span class="payload">100 – 600 kg</span>
            <span class="clients">ZF · Bosch</span>
          </div>
        </a>
        <a class="industry-row" href="/branchen/nutzfahrzeuge-schwermontage">
          <div class="industry-num">04</div>
          <div class="industry-body">
            <h3>Nutzfahrzeuge &amp; Schwermontage</h3>
            <p>Nutzfahrzeugrahmen, große Unterbaugruppen und Industriemaschinen — wo Lastanforderungen das übersteigen, was Standardfördersysteme leisten können.</p>
          </div>
          <div class="industry-meta">
            <span class="payload">Bis 2.000 kg</span>
            <span class="clients">Sonderrahmen</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ════ 7. TECH COMPARISON ════ -->
  <section class="tech-band">
    <div class="container">
      <div class="tech-band-inner">
        <div class="tech-band-text">
          <div class="tech-eyebrow">Technologievergleich</div>
          <h2>eCart vs. AGV vs. Kettenförderer.</h2>
          <p class="intro">
            Drei Technologien konkurrieren um dieselbe Montagefläche.
            Die richtige Wahl hängt von Traglast, Takt und
            Infrastrukturbedingungen ab.
          </p>
          <a href="/ressourcen/technologievergleich" class="btn btn-ghost">Vollständiger Vergleich →</a>
        </div>

        <div class="tech-comparison">
          <div class="comparison-header">
            <span>Kriterium</span>
            <span>eCart</span>
            <span>AGV</span>
            <span>Kette</span>
          </div>
          <div class="comparison-row"><span class="attr">Stoppgenauigkeit</span><span class="val val-accent">±0,1 mm</span><span class="val val-neutral">±5–30 mm</span><span class="val val-neutral">±1–5 mm</span></div>
          <div class="comparison-row"><span class="attr">Inbetriebnahme</span><span class="val val-accent">Tage</span><span class="val val-neutral">Wochen</span><span class="val val-neutral">Wochen</span></div>
          <div class="comparison-row"><span class="attr">Energieverbrauch</span><span class="val val-accent">Niedrig</span><span class="val val-neutral">Mittel</span><span class="val val-no">Hoch</span></div>
          <div class="comparison-row"><span class="attr">Netzwerk erforderlich</span><span class="val val-yes">Keins</span><span class="val val-no">WLAN</span><span class="val val-yes">Keins</span></div>
          <div class="comparison-row"><span class="attr">Aktive Bremse</span><span class="val val-yes">Ja</span><span class="val val-yes">Ja</span><span class="val val-no">Nein</span></div>
          <div class="comparison-row"><span class="attr">Umrüstung</span><span class="val val-accent">Stunden</span><span class="val val-neutral">Tage</span><span class="val val-no">Wochen</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════ 8. FOOTER CTA ════ -->
  <section class="footer-cta" id="contact">
    <div class="footer-cta-bg"></div>
    <div class="container footer-cta-content">
      <div class="footer-cta-eyebrow">Gespräch beginnen</div>
      <h2>Gemeinsam entwickeln wir<br><em>Ihre nächste Linie.</em></h2>
      <p>
        Vom Konzept bis zur Inbetriebnahme. Schildern Sie uns Ihr Projekt —
        wir zeigen Ihnen, was möglich ist.
      </p>
      <div class="footer-cta-btns">
        <a href="/kontakt" class="btn btn-accent">Projekt anfragen →</a>
        <a href="/downloads/ecart-broschuere" class="btn btn-ghost-light">Produktbroschüre herunterladen</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ───── Local tokens ───── */
  :root {
    --dark-text-strong: color-mix(in srgb, var(--color-dark-text) 70%, transparent);
    --dark-text-subtle: color-mix(in srgb, var(--color-dark-text) 42%, transparent);
    --dark-border: rgba(255, 255, 255, 0.07);
  }

  /* ───── Layout helper ───── */
  .container {
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 0 64px;
  }

  /* ───── Button variants (page-scoped) ───── */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 26px;
    border-radius: var(--radius-pill);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
    transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease;
    white-space: nowrap;
    border: none;
    letter-spacing: 0.1px;
  }
  .btn-dark { background: var(--color-text); color: var(--color-bg); }
  .btn-dark:hover { background: #333; }
  .btn-accent { background: var(--color-accent); color: var(--color-text); }
  .btn-accent:hover { background: var(--color-accent-hover); }
  .btn-ghost { background: transparent; color: var(--color-text); border: 1px solid var(--color-border); }
  .btn-ghost:hover { border-color: var(--color-text); }
  .btn-ghost-light { background: transparent; color: var(--color-dark-text); border: 1px solid rgba(232, 228, 221, 0.25); }
  .btn-ghost-light:hover { border-color: rgba(232, 228, 221, 0.6); }

  /* ───── 1. HERO ───── */
  .hero {
    min-height: 100vh;
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--color-dark-bg);
  }
  .hero-fade {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 70% 50%, rgba(232, 181, 0, 0.04) 0%, transparent 60%),
      radial-gradient(ellipse at 10% 80%, rgba(232, 181, 0, 0.025) 0%, transparent 50%);
    pointer-events: none;
  }
  .hero-content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
    padding: 160px 64px 96px;
  }
  .hero-eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .hero-eyebrow::before {
    content: '';
    display: block;
    width: 24px;
    height: 1px;
    background: var(--color-accent);
    flex-shrink: 0;
  }
  .hero h1 {
    font-family: var(--font-heading);
