---
import type { GetStaticPaths } from 'astro';
import { toHTML } from '@portabletext/to-html';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Section from '../../../components/Section.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SanityImage from '../../../components/SanityImage.astro';
import { getAllProducts, getProductBySlug } from '../../../sanity/queries';
import { productSchema, faqSchema } from '../../../lib/schema-org';

export const getStaticPaths = (async () => {
  const products = await getAllProducts('de');
  return products
    .filter((p) => p.productFamily?.slug?.current && p.slug?.current)
    .map((p) => ({
      params: {
        familySlug: p.productFamily!.slug!.current,
        productSlug: p.slug.current,
      },
    }));
}) satisfies GetStaticPaths;

const { familySlug, productSlug } = Astro.params;
const product = productSlug ? await getProductBySlug(productSlug, 'de') : null;

if (!product || product.productFamily?.slug?.current !== familySlug) {
  return Astro.redirect('/404');
}

const introHtml = product.intro ? toHTML(product.intro as any) : '';
const bodyHtml = product.body ? toHTML(product.body as any) : '';

const familyName = product.productFamily?.name ?? '';
const showFamilyCrumb = familyName.toLowerCase() !== product.name.toLowerCase();
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Produkte', href: '/produkte' },
  ...(showFamilyCrumb ? [{ label: familyName, href: `/produkte/${familySlug}` }] : []),
  { label: product.name },
];

const pageUrl = `/produkte/${familySlug}/${productSlug}`;
const jsonLd = [
  productSchema({
    name: product.name,
    description: product.metaDescription ?? product.tagline,
    url: pageUrl,
    category: 'Fördersystem',
    specs: product.specs?.map((s) => ({ label: s.label, value: s.value, unit: s.unit })),
  }),
  ...(product.faq && product.faq.length > 0 ? [faqSchema(product.faq)] : []),
];
---

<BaseLayout
  title={`${product.name} — KRUPS Automation`}
  description={product.metaDescription ?? product.tagline}
  locale="de"
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
>
  <section class="page-hero">
    <div class="page-hero-inner">
      <Breadcrumbs items={breadcrumbs} />
      <div class="page-hero-text">
        <h1>{product.name}</h1>
        {product.tagline && <p class="hero-lede">{product.tagline}</p>}
      </div>
    </div>
    {product.heroImage && (
      <div class="page-hero-img">
        <SanityImage
          source={product.heroImage}
          alt={product.name}
          width={800}
          loading="eager"
          fetchpriority="high"
          sizes="45vw"
          class="hero-photo"
        />
      </div>
    )}
  </section>

  <Section surface="paper">
    {introHtml && <div class="intro" set:html={introHtml} />}

    {product.specs && product.specs.length > 0 && (
      <div class="specs">
        <h2>Technische Daten</h2>
        <dl class="spec-list">
          {product.specs.map((s) => (
            <div class="spec-row">
              <dt>{s.label}</dt>
              <dd>
                {s.value}
                {s.unit && <span class="unit"> {s.unit}</span>}
                {s.notes && <span class="notes"> · {s.notes}</span>}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    )}
  </Section>

  <Section surface="clay">
    {product.keyFeatures && product.keyFeatures.length > 0 && (
      <div class="features">
        <h2>Merkmale</h2>
        <ul class="feature-list">
          {product.keyFeatures.map((f) => (
            <li>
              <h3>{f.title}</h3>
              {f.description && <p>{f.description}</p>}
            </li>
          ))}
        </ul>
      </div>
    )}

    {bodyHtml && <div class="product-body" set:html={bodyHtml} />}
  </Section>

  {(product.faq?.length > 0 || product.downloads?.length > 0) && (
    <Section surface="paper">
      {product.faq && product.faq.length > 0 && (
        <div class="faq">
          <h2>Häufige Fragen</h2>
          {product.faq.map((q) => (
            <details class="faq-item">
              <summary>{q.question}</summary>
              <p>{q.answer}</p>
            </details>
          ))}
        </div>
      )}

      {product.downloads && product.downloads.length > 0 && (
        <div class="downloads">
          <h2>Downloads</h2>
          <ul>
            {product.downloads.map((d: any) => (
              <li>
                <a href={d.file?.asset?.url ?? '#'}>
                  {d.title}
                  {d.fileType && <span class="type"> · {d.fileType.toUpperCase()}</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </Section>
  )}
</BaseLayout>

<style>
  /* ── page hero ── */
  .page-hero {
    position: relative;
    min-height: 480px;
    background: var(--color-dark-bg);
    overflow: hidden;
  }
  .page-hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
    padding: calc(var(--nav-height) + var(--space-16)) var(--space-16) var(--space-16);
    min-height: 480px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .page-hero-inner :global(.breadcrumbs ol) { color: var(--color-dark-muted); }
  .page-hero-inner :global(.breadcrumbs a) { color: var(--color-dark-muted); }
  .page-hero-inner :global(.breadcrumbs a:hover) { color: var(--color-dark-text); }
  .page-hero-inner :global(.breadcrumbs [aria-current='page']) { color: var(--color-dark-text); }
  .page-hero-text { max-width: 55%; margin-top: var(--space-5); }
  .page-hero-text h1 {
    font-family: var(--font-heading);
    font-size: clamp(40px, 4.5vw, 64px);
    font-weight: 600;
    line-height: 1.02;
    color: var(--color-dark-text);
    margin-bottom: var(--space-4);
  }
  .hero-lede {
    font-size: 17px;
    color: var(--color-dark-muted);
    line-height: 1.6;
    max-width: 46ch;
  }
  .page-hero-img {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 45%;
    z-index: 1;
  }
  .page-hero-img::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(90deg, var(--color-dark-bg) 0%, rgba(28,28,26,0.5) 50%, rgba(28,28,26,0) 100%);
  }
  .page-hero-img :global(.hero-photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  @media (max-width: 768px) {
    .page-hero { min-height: unset; }
    .page-hero-inner { min-height: unset; padding: calc(var(--nav-height) + var(--space-8)) var(--space-6) var(--space-8); }
    .page-hero-text { max-width: 100%; }
    .page-hero-img { position: static; width: 100%; height: 240px; }
    .page-hero-img::before { background: linear-gradient(180deg, rgba(28,28,26,0.4) 0%, rgba(28,28,26,0) 60%); }
  }
  /* ── product body ── */
  .intro :global(p) { font-size: 16px; line-height: 1.7; color: var(--color-muted); margin-bottom: var(--space-4); max-width: 65ch; margin-top: var(--space-6); }
  h2 {
    font-family: var(--font-heading);
    font-size: var(--font-size-h2-section);
    font-weight: 500;
    margin: var(--space-10) 0 var(--space-4);
  }
  .specs h2,
  .features h2,
  .faq h2 { margin-top: 0; }
  .spec-list {
    border-top: 1px solid var(--color-border);
  }
  .spec-row {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 32px;
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
    align-items: baseline;
  }
  .spec-row dt {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-muted);
    padding-top: 2px;
  }
  .spec-row dd {
    font-size: 16px;
    font-weight: 500;
    color: var(--color-text);
  }
  .spec-row .unit { color: var(--color-muted); font-weight: 400; font-size: 14px; }
  .spec-row .notes { color: var(--color-muted); font-size: 13px; font-weight: 400; }
  .feature-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
    list-style: none;
    padding: 0;
    counter-reset: feature-counter;
  }
  .feature-list li {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-top: 2px solid var(--color-accent);
    border-radius: var(--radius-lg);
    padding: 28px 24px 24px;
    counter-increment: feature-counter;
    position: relative;
  }
  .feature-list li::before {
    content: counter(feature-counter, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 1px;
    color: var(--color-accent);
    display: block;
    margin-bottom: var(--space-3);
  }
  .feature-list h3 {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 500;
    margin-bottom: var(--space-2);
    line-height: 1.15;
  }
  .feature-list p {
    font-size: 14px;
    color: var(--color-muted);
    line-height: 1.6;
  }
  .product-body :global(p) { max-width: 65ch; line-height: 1.7; margin-bottom: var(--space-4); }
  .faq-item {
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-4) 0;
  }
  .faq-item summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item p {
    margin-top: var(--space-3);
    color: var(--color-muted);
    line-height: 1.65;
    max-width: 65ch;
  }
  .downloads { margin-top: var(--space-10); }
  .downloads ul { list-style: none; padding: 0; }
  .downloads li { padding: var(--space-2) 0; border-bottom: 1px solid var(--color-border); }
  .downloads a { color: var(--color-text); font-weight: 500; }
  .downloads .type { color: var(--color-muted); font-family: var(--font-mono); font-size: 12px; }
  @media (max-width: 768px) {
    .spec-row { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
