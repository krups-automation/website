---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import ProductDetail from '../../../components/ProductDetail.astro';
import { getAllProducts, getProductBySlug, getSingleMemberFamilySlugs } from '../../../sanity/queries';
import { productSchema, faqSchema } from '../../../lib/schema-org';

export const getStaticPaths = (async () => {
  const [products, singleMemberFamilies] = await Promise.all([
    getAllProducts('de'),
    getSingleMemberFamilySlugs('de'),
  ]);
  // single-member families collapse into the family page — no separate product route
  return products
    .filter((p) => p.productFamily?.slug?.current && p.slug?.current)
    .filter((p) => !singleMemberFamilies.includes(p.productFamily!.slug!.current))
    .map((p) => ({
      params: {
        familySlug: p.productFamily!.slug!.current,
        productSlug: p.slug.current,
      },
    }));
}) satisfies GetStaticPaths;

const { familySlug, productSlug } = Astro.params;
const product = productSlug ? await getProductBySlug(productSlug, 'de') : null;

if (!product || product.productFamily?.slug?.current !== familySlug) {
  // Paths come from getStaticPaths, so a miss means CMS/data drift: fail the build
  // instead of emitting a redirect page that crawlers treat as a soft 404.
  throw new Error(`No product found for ${Astro.url.pathname}`);
}

const familyName = product.productFamily?.name ?? '';
const showFamilyCrumb = familyName.toLowerCase() !== product.name.toLowerCase();
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Produkte', href: '/produkte' },
  ...(showFamilyCrumb ? [{ label: familyName, href: `/produkte/${familySlug}` }] : []),
  { label: product.name },
];

const pageUrl = `/produkte/${familySlug}/${productSlug}`;
const jsonLd = [
  productSchema({
    name: product.name,
    description: product.metaDescription ?? product.tagline,
    url: pageUrl,
    category: 'Fördersystem',
    specs: product.specs?.map((s) => ({ label: s.label, value: s.value, unit: s.unit })),
  }),
  ...(product.faq && product.faq.length > 0 ? [faqSchema(product.faq)] : []),
];
---

<BaseLayout
  title={`${product.name} — KRUPS Automation`}
  description={product.metaDescription ?? product.tagline}
  locale="de"
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
>
  <PageHero
    breadcrumbs={breadcrumbs}
    title={product.name}
    lede={product.tagline}
    image={product.heroImage}
  />

  <ProductDetail product={product} />
</BaseLayout>
