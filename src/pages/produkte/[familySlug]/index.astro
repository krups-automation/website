---
import type { GetStaticPaths } from 'astro';
import { toHTML } from '@portabletext/to-html';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import ProductDetail from '../../../components/ProductDetail.astro';
import Section from '../../../components/Section.astro';
import { getAllProductFamilies, getProductFamilyBySlug, getProductBySlug } from '../../../sanity/queries';
import { productSchema, faqSchema } from '../../../lib/schema-org';

export const getStaticPaths = (async () => {
  const families = await getAllProductFamilies('de');
  return families.map((f) => ({ params: { familySlug: f.slug.current } }));
}) satisfies GetStaticPaths;

const { familySlug } = Astro.params;
const family = familySlug ? await getProductFamilyBySlug(familySlug, 'de') : null;

if (!family) {
  return Astro.redirect('/404');
}

// single-member families collapse: this page renders the full product content
const soleMemberSlug = family.members?.length === 1 ? family.members[0].slug?.current : null;
const product = soleMemberSlug ? await getProductBySlug(soleMemberSlug, 'de') : null;

const introHtml = family.intro ? toHTML(family.intro as any) : '';
const bodyHtml = family.body ? toHTML(family.body as any) : '';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Produkte', href: '/produkte' },
  { label: family.name },
];

const jsonLd = product
  ? [
      productSchema({
        name: product.name,
        description: product.metaDescription ?? product.tagline ?? family.tagline,
        url: `/produkte/${familySlug}`,
        category: 'Fördersystem',
        specs: product.specs?.map((s) => ({ label: s.label, value: s.value, unit: s.unit })),
      }),
      ...(product.faq && product.faq.length > 0 ? [faqSchema(product.faq)] : []),
    ]
  : undefined;
---

<BaseLayout
  title={`${family.name} — KRUPS Automation`}
  description={family.metaDescription ?? family.tagline}
  locale="de"
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
>
  <PageHero
    breadcrumbs={breadcrumbs}
    title={family.name}
    lede={family.tagline}
    image={family.heroImage}
  />

  {product ? (
    <ProductDetail product={product} />
  ) : (
    <Section surface="paper">
      {introHtml && (
        <div class="intro-block">
          <div class="eyebrow">Das System</div>
          <div class="intro" set:html={introHtml} />
        </div>
      )}

      {family.members && family.members.length > 0 && (
        <div class="member-grid">
          {family.members.map((m) => (
            <a class="member-card" href={`/produkte/${family.slug.current}/${m.slug.current}`}>
              <h2>{m.name}</h2>
              {m.tagline && <p>{m.tagline}</p>}
              {m.specs && m.specs.length > 0 && (
                <dl class="card-specs">
                  {m.specs.map((s: any) => (
                    <div class="spec-row">
                      <dt>{s.label}</dt>
                      <dd>{s.value}{s.unit ? ` ${s.unit}` : ''}</dd>
                    </div>
                  ))}
                </dl>
              )}
              <span class="card-link">Details <span class="card-arrow">→</span></span>
            </a>
          ))}
        </div>
      )}

      {bodyHtml && <div class="family-body" set:html={bodyHtml} />}
    </Section>
  )}

  <Section surface="paper" class="sonder-section">
    <aside class="sonder-cta">
      <h2>Sonderentwicklung gefragt?</h2>
      <p>
        Passt nichts vollständig zu Ihrer Aufgabe? Wir entwickeln aus dem Standard
        heraus — mit voller Eigenfertigung in Dernbach.
      </p>
      <a href="/kontakt" class="btn-inline">Projekt besprechen →</a>
    </aside>
  </Section>
</BaseLayout>

<style>
  /* ── intro: first paragraph reads as a lede, rest as body ── */
  .intro-block { max-width: 720px; margin-bottom: var(--space-10); }
  .intro :global(p) {
    font-size: var(--font-size-body-sm);
    line-height: 1.7;
    color: var(--color-muted);
    margin-bottom: var(--space-4);
    max-width: 65ch;
  }
  .intro :global(p:first-of-type) {
    font-size: var(--font-size-card-title-sm);
    line-height: 1.55;
    color: var(--color-text);
  }
  .intro :global(strong) { color: var(--color-text); }

  .member-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: var(--space-4);
  }
  .member-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    color: var(--color-text);
    display: flex;
    flex-direction: column;
    transition: border-color var(--duration-short) ease;
  }
  .member-card:hover { border-color: var(--color-accent-soft); }
  .member-card h2 {
    font-family: var(--font-heading);
    font-size: var(--font-size-card-title);
    font-weight: 500;
    margin-bottom: var(--space-2);
    line-height: 1.15;
  }
  .member-card p {
    font-size: var(--font-size-specs);
    color: var(--color-muted);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }
  /* spec rows pinned to the card bottom so all cards align identically */
  .card-specs {
    margin: auto 0 var(--space-5);
    padding-top: var(--space-4);
  }
  .spec-row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-4);
    align-items: baseline;
    padding: var(--space-2) 0;
    border-top: 1px solid var(--color-border);
  }
  .spec-row dt {
    font-family: var(--font-mono);
    font-size: var(--font-size-eyebrow);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .spec-row dd {
    font-family: var(--font-mono);
    font-size: var(--font-size-label);
    color: var(--color-text);
    text-align: right;
    white-space: nowrap;
  }
  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--font-size-label);
    font-weight: 600;
    color: var(--color-text);
  }
  .card-arrow { display: inline-block; transition: transform var(--duration-short) ease; }
  .member-card:hover .card-arrow { transform: translateX(4px); }
  .family-body :global(p) { max-width: 65ch; margin-bottom: var(--space-4); line-height: 1.7; }
  .family-body :global(h2) { margin: var(--space-8) 0 var(--space-3); font-family: var(--font-heading); }

  /* CTA sits in its own slim section so it follows both page variants */
  :global(.sonder-section) { padding-top: 0 !important; }
  .sonder-cta {
    padding: var(--space-10);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }
  .sonder-cta h2 {
    font-family: var(--font-heading);
    font-size: var(--font-size-h2-section);
    font-weight: 500;
    margin-bottom: var(--space-3);
  }
  .sonder-cta p {
    font-size: var(--font-size-body-sm);
    color: var(--color-muted);
    line-height: 1.65;
    margin-bottom: var(--space-4);
    max-width: 540px;
  }
  .btn-inline {
    font-size: var(--font-size-specs);
    font-weight: 600;
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-accent);
    text-underline-offset: 4px;
  }
</style>
