---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import PageHeader from '../../components/PageHeader.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getServicesByTier } from '../../sanity/queries';

const services = await getServicesByTier('run', 'de');
---

<BaseLayout
  title="Leistungen — KRUPS Automation"
  description="Projektierung, Fertigung, Montage, Steuerungsintegration und Service für schienengeführte Fördersysteme."
  locale="de"
  breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Leistungen' }]}
>
  <div class="page-spacer"></div>

  <Section surface="paper">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Leistungen' }]} />
    <PageHeader
      eyebrow="Run"
      title="Beratung bis Betrieb."
      lede="Das komplette Leistungsspektrum aus einer Hand: Projektierung, Fertigung, Montage, Steuerungsintegration und Service. Die Linie läuft — wir halten sie am Laufen."
    />
  </Section>

  <Section surface="clay">
    {services.length === 0 ? (
      <div class="empty-state">
        <p>Leistungsinhalte werden derzeit im Studio gepflegt. <a href="/kontakt">Kontakt</a></p>
      </div>
    ) : (
      <div class="service-grid">
        {services.map((s) => (
          <a class="service-card" href={`/leistungen/${s.slug.current}`}>
            <h2>{s.name}</h2>
            {s.summary && <p>{s.summary}</p>}
            <span class="card-link">Mehr erfahren <span class="card-arrow">→</span></span>
          </a>
        ))}
      </div>
    )}
  </Section>
</BaseLayout>

<style>
  .service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-4);
  }
  /* Cards on clay — use --color-bg for contrast */
  .service-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    color: var(--color-text);
    transition: border-color var(--duration-short) ease, transform var(--duration-short) ease, box-shadow var(--duration-short) ease;
  }
  .service-card:hover {
    border-color: var(--color-accent-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }
  .service-card h2 {
    font-family: var(--font-heading);
    font-size: var(--font-size-card-title);
    font-weight: 500;
    line-height: 1.15;
    margin-bottom: var(--space-3);
  }
  .service-card p {
    font-size: var(--font-size-specs);
    color: var(--color-muted);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }
  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--font-size-label);
    font-weight: 600;
    color: var(--color-text);
    margin-top: auto;
  }
  .card-arrow { display: inline-block; transition: transform var(--duration-short) ease; }
  .service-card:hover .card-arrow { transform: translateX(8px); }
  .empty-state {
    padding: var(--space-12);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-muted);
    text-align: center;
  }
  .empty-state a { color: var(--color-text); text-decoration: underline; text-decoration-color: var(--color-accent); text-underline-offset: 4px; }
</style>
