---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getServicesByTier } from '../../sanity/queries';

const services = await getServicesByTier('run', 'de');
---

<BaseLayout
  title="Leistungen — KRUPS Automation"
  description="Projektierung, Fertigung, Montage, Steuerungsintegration und Service für schienengeführte Fördersysteme."
  locale="de"
  breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Leistungen' }]}
>
  <div class="page-spacer"></div>

  <Section surface="paper">
    <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Leistungen' }]} />

    <header class="page-header">
      <div class="eyebrow">Run</div>
      <h1>Beratung bis Betrieb.</h1>
      <p class="lede">
        Das komplette Leistungsspektrum aus einer Hand: Projektierung, Fertigung,
        Montage, Steuerungsintegration und Service. Die Linie läuft — wir halten sie am Laufen.
      </p>
    </header>

    {services.length === 0 ? (
      <div class="empty-state">
        <p>Leistungsinhalte werden derzeit im Studio gepflegt. <a href="/kontakt">Kontakt</a></p>
      </div>
    ) : (
      <div class="service-grid">
        {services.map((s) => (
          <a class="service-card" href={`/leistungen/${s.slug.current}`}>
            <h2>{s.name}</h2>
            {s.summary && <p>{s.summary}</p>}
            <span class="card-link">Mehr erfahren <span class="card-arrow">→</span></span>
          </a>
        ))}
      </div>
    )}
  </Section>
</BaseLayout>

<style>
  .page-spacer { height: 100px; }
  .page-header { margin: var(--space-6) 0 var(--space-12); max-width: 720px; }
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-4);
  }
  .page-header h1 {
    font-family: var(--font-heading);
    font-size: clamp(40px, 4.5vw, 64px);
    font-weight: 600;
    line-height: 1.05;
    margin-bottom: var(--space-4);
  }
  .lede {
    font-size: 17px;
    color: var(--color-muted);
    line-height: 1.65;
    max-width: 560px;
  }
  .service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 16px;
  }
  .service-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 32px;
    display: flex;
    flex-direction: column;
    color: var(--color-text);
    transition: border-color 220ms ease;
  }
  .service-card:hover { border-color: rgba(232, 181, 0, 0.5); }
  .service-card h2 {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 500;
    line-height: 1.15;
    margin-bottom: var(--space-3);
  }
  .service-card p {
    font-size: 14px;
    color: var(--color-muted);
    line-height: 1.6;
    margin-bottom: var(--space-4);
  }
  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text);
    margin-top: auto;
  }
  .card-arrow { display: inline-block; transition: transform 150ms ease; }
  .service-card:hover .card-arrow { transform: translateX(4px); }
  .empty-state {
    padding: 48px;
    border: 1px dashed var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-muted);
    text-align: center;
  }
  .empty-state a { color: var(--color-text); text-decoration: underline; text-decoration-color: var(--color-accent); text-underline-offset: 4px; }
</style>
