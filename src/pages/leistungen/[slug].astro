---
import type { GetStaticPaths } from 'astro';
import { toHTML } from '@portabletext/to-html';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Section from '../../components/Section.astro';
import { getServicesByTier, getServiceBySlug } from '../../sanity/queries';
import { serviceSchema, faqSchema } from '../../lib/schema-org';

export const getStaticPaths = (async () => {
  const services = await getServicesByTier('run', 'de');
  return services.map((s) => ({ params: { slug: s.slug.current } }));
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const service = slug ? await getServiceBySlug(slug, 'de') : null;

if (!service || service.tier !== 'run') {
  return Astro.redirect('/404');
}

const bodyHtml = service.body ? toHTML(service.body as any) : '';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Leistungen', href: '/leistungen' },
  { label: service.name },
];
const jsonLd = [
  serviceSchema({
    name: service.name,
    description: service.metaDescription ?? service.summary,
    url: `/leistungen/${slug}`,
  }),
  ...(service.faq && service.faq.length > 0 ? [faqSchema(service.faq)] : []),
];
---

<BaseLayout
  title={service.metaTitle ?? `${service.name} — KRUPS Automation`}
  description={service.metaDescription ?? service.summary}
  locale="de"
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
>
  <PageHero
    breadcrumbs={breadcrumbs}
    title={service.name}
    lede={service.summary}
    image={service.heroImage}
  />

  <Section surface="paper">
    {service.processSteps && service.processSteps.length > 0 && (
      <div class="steps">
        <h2>Vorgehen</h2>
        <ol class="step-list">
          {service.processSteps.map((s) => (
            <li>
              <span class="step-num">{s.stepNumber ?? ''}</span>
              <div>
                <h3>{s.title}</h3>
                {s.description && <p>{s.description}</p>}
              </div>
            </li>
          ))}
        </ol>
      </div>
    )}

    {service.deliverables && service.deliverables.length > 0 && (
      <div class="deliverables">
        <h2>Ergebnisse</h2>
        <ul>
          {service.deliverables.map((d) => <li>{d}</li>)}
        </ul>
      </div>
    )}

    {bodyHtml && <div class="service-body" set:html={bodyHtml} />}

    {service.faq && service.faq.length > 0 && (
      <div class="faq">
        <h2>Häufige Fragen</h2>
        {service.faq.map((q) => (
          <details class="faq-item">
            <summary>{q.question}</summary>
            <p>{q.answer}</p>
          </details>
        ))}
      </div>
    )}
  </Section>
</BaseLayout>

<style>
  h2 {
    font-family: var(--font-heading);
    font-size: var(--font-size-h2-section);
    font-weight: 500;
    margin: var(--space-10) 0 var(--space-4);
  }
  .step-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }
  .step-list li {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: var(--space-6);
    padding: var(--space-6);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .step-num {
    font-family: var(--font-heading);
    font-size: var(--font-size-card-title-lg);
    font-weight: 300;
    color: var(--color-accent);
    line-height: 1;
  }
  .step-list h3 {
    font-family: var(--font-heading);
    font-size: var(--font-size-body);
    font-weight: 500;
    margin-bottom: var(--space-2);
  }
  .step-list p {
    font-size: var(--font-size-specs);
    color: var(--color-muted);
    line-height: 1.6;
  }
  .deliverables ul {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: var(--space-3);
  }
  .deliverables li {
    padding: var(--space-4) var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: var(--font-size-specs);
  }
  .service-body :global(p) { max-width: 65ch; line-height: 1.7; margin-bottom: var(--space-4); }
  .faq-item {
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-4) 0;
  }
  .faq-item summary { cursor: pointer; font-weight: 600; font-size: var(--font-size-body-sm); }
  .faq-item p { margin-top: var(--space-3); color: var(--color-muted); line-height: 1.65; max-width: 65ch; }
</style>
