---
import type { GetStaticPaths } from 'astro';
import { toHTML } from '@portabletext/to-html';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SanityImage from '../../components/SanityImage.astro';
import { getServicesByTier, getServiceBySlug } from '../../sanity/queries';
import { serviceSchema, faqSchema } from '../../lib/schema-org';

export const getStaticPaths = (async () => {
  const services = await getServicesByTier('run', 'de');
  return services.map((s) => ({ params: { slug: s.slug.current } }));
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const service = slug ? await getServiceBySlug(slug, 'de') : null;

if (!service || service.tier !== 'run') {
  return Astro.redirect('/404');
}

const bodyHtml = service.body ? toHTML(service.body as any) : '';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Leistungen', href: '/leistungen' },
  { label: service.name },
];
const jsonLd = [
  serviceSchema({
    name: service.name,
    description: service.metaDescription ?? service.summary,
    url: `/leistungen/${slug}`,
  }),
  ...(service.faq && service.faq.length > 0 ? [faqSchema(service.faq)] : []),
];
---

<BaseLayout
  title={service.metaTitle ?? `${service.name} — KRUPS Automation`}
  description={service.metaDescription ?? service.summary}
  locale="de"
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
>
  <section class="page-hero">
    <div class="page-hero-inner">
      <Breadcrumbs items={breadcrumbs} />
      <div class="page-hero-text">
        <h1>{service.name}</h1>
        {service.summary && <p class="hero-lede">{service.summary}</p>}
      </div>
    </div>
    {service.heroImage && (
      <div class="page-hero-img">
        <SanityImage
          source={service.heroImage}
          alt={service.name}
          width={800}
          loading="eager"
          fetchpriority="high"
          sizes="45vw"
          class="hero-photo"
        />
      </div>
    )}
  </section>

  <Section surface="paper">
    {service.processSteps && service.processSteps.length > 0 && (
      <div class="steps">
        <h2>Vorgehen</h2>
        <ol class="step-list">
          {service.processSteps.map((s) => (
            <li>
              <span class="step-num">{s.stepNumber ?? ''}</span>
              <div>
                <h3>{s.title}</h3>
                {s.description && <p>{s.description}</p>}
              </div>
            </li>
          ))}
        </ol>
      </div>
    )}

    {service.deliverables && service.deliverables.length > 0 && (
      <div class="deliverables">
        <h2>Ergebnisse</h2>
        <ul>
          {service.deliverables.map((d) => <li>{d}</li>)}
        </ul>
      </div>
    )}

    {bodyHtml && <div class="service-body" set:html={bodyHtml} />}

    {service.faq && service.faq.length > 0 && (
      <div class="faq">
        <h2>Häufige Fragen</h2>
        {service.faq.map((q) => (
          <details class="faq-item">
            <summary>{q.question}</summary>
            <p>{q.answer}</p>
          </details>
        ))}
      </div>
    )}
  </Section>
</BaseLayout>

<style>
  /* ── page hero ── */
  .page-hero {
    position: relative;
    min-height: 480px;
    background: var(--color-dark-bg);
    overflow: hidden;
  }
  .page-hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
    padding: calc(var(--nav-height) + var(--space-16)) var(--space-16) var(--space-16);
    min-height: 480px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .page-hero-inner :global(.breadcrumbs ol) { color: var(--color-dark-muted); }
  .page-hero-inner :global(.breadcrumbs a) { color: var(--color-dark-muted); }
  .page-hero-inner :global(.breadcrumbs a:hover) { color: var(--color-dark-text); }
  .page-hero-inner :global(.breadcrumbs [aria-current='page']) { color: var(--color-dark-text); }
  .page-hero-text { max-width: 55%; margin-top: var(--space-5); }
  .page-hero-text h1 {
    font-family: var(--font-heading);
    font-size: clamp(40px, 4.5vw, 64px);
    font-weight: 600;
    line-height: 1.02;
    color: var(--color-dark-text);
    margin-bottom: var(--space-4);
  }
  .hero-lede {
    font-size: 17px;
    color: var(--color-dark-muted);
    line-height: 1.6;
    max-width: 46ch;
  }
  .page-hero-img {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 45%;
    z-index: 1;
  }
  .page-hero-img::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(90deg, var(--color-dark-bg) 0%, rgba(28,28,26,0.5) 50%, rgba(28,28,26,0) 100%);
  }
  .page-hero-img :global(.hero-photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  @media (max-width: 768px) {
    .page-hero { min-height: unset; }
    .page-hero-inner { min-height: unset; padding: calc(var(--nav-height) + var(--space-8)) var(--space-6) var(--space-8); }
    .page-hero-text { max-width: 100%; }
    .page-hero-img { position: static; width: 100%; height: 240px; }
    .page-hero-img::before { background: linear-gradient(180deg, rgba(28,28,26,0.4) 0%, rgba(28,28,26,0) 60%); }
  }
  h2 {
    font-family: var(--font-heading);
    font-size: var(--font-size-h2-section);
    font-weight: 500;
    margin: var(--space-10) 0 var(--space-4);
  }
  .step-list {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 16px;
  }
  .step-list li {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 24px;
    padding: 24px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .step-num {
    font-family: var(--font-heading);
    font-size: 32px;
    font-weight: 300;
    color: var(--color-accent);
    line-height: 1;
  }
  .step-list h3 {
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 500;
    margin-bottom: var(--space-2);
  }
  .step-list p {
    font-size: 14px;
    color: var(--color-muted);
    line-height: 1.6;
  }
  .deliverables ul {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 12px;
  }
  .deliverables li {
    padding: 16px 20px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    font-size: 14px;
  }
  .service-body :global(p) { max-width: 65ch; line-height: 1.7; margin-bottom: var(--space-4); }
  .faq-item {
    border-bottom: 1px solid var(--color-border);
    padding: var(--space-4) 0;
  }
  .faq-item summary { cursor: pointer; font-weight: 600; font-size: 16px; }
  .faq-item p { margin-top: var(--space-3); color: var(--color-muted); line-height: 1.65; max-width: 65ch; }
</style>
