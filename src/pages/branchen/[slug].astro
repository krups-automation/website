---
import type { GetStaticPaths } from 'astro';
import { toHTML } from '@portabletext/to-html';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SanityImage from '../../components/SanityImage.astro';
import { getAllIndustrySlugs, getIndustryBySlug } from '../../sanity/queries';
import { faqSchema } from '../../lib/schema-org';

export const getStaticPaths = (async () => {
  const industries = await getAllIndustrySlugs('de');
  return industries.map(({ slug }) => ({ params: { slug } }));
}) satisfies GetStaticPaths;

const { slug } = Astro.params;
const industry = slug ? await getIndustryBySlug(slug, 'de') : null;

if (!industry) {
  return Astro.redirect('/404');
}

const whatMovesHtml = industry.whatMoves ? toHTML(industry.whatMoves as any) : '';
const bottleneckHtml = industry.bottleneck ? toHTML(industry.bottleneck as any) : '';
const alternativesHtml = industry.alternatives ? toHTML(industry.alternatives as any) : '';
const solutionHtml = industry.solutionRouting ? toHTML(industry.solutionRouting as any) : '';

const jsonLd = industry.faq && industry.faq.length > 0 ? [faqSchema(industry.faq)] : [];
const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Branchen', href: '/branchen' },
  { label: industry.name },
];
---

<BaseLayout
  title={industry.metaTitle ?? `${industry.name} — KRUPS Automation`}
  description={industry.metaDescription ?? industry.tagline}
  locale="de"
  breadcrumbs={breadcrumbs}
  jsonLd={jsonLd}
>
  <section class="page-hero">
    <div class="page-hero-inner">
      <Breadcrumbs items={breadcrumbs} />
      <div class="page-hero-text">
        <h1>{industry.name}</h1>
        {industry.tagline && <p class="hero-lede">{industry.tagline}</p>}
      </div>
    </div>
    {industry.heroImage && (
      <div class="page-hero-img">
        <SanityImage
          source={industry.heroImage}
          alt={industry.name}
          width={800}
          loading="eager"
          fetchpriority="high"
          sizes="45vw"
          class="hero-photo"
        />
      </div>
    )}
  </section>

  <Section surface="paper">
    {industry.characterBar && industry.characterBar.length > 0 && (
      <ul class="char-bar">
        {industry.characterBar.map((c) => (
          <li>
            <span class="lbl">{c.label}</span>
            <span class="val">{c.value}</span>
          </li>
        ))}
      </ul>
    )}

    {whatMovesHtml && (
      <section class="prose">
        <h2>Was transportiert wird</h2>
        <div set:html={whatMovesHtml} />
      </section>
    )}

    {bottleneckHtml && (
      <section class="prose">
        <h2>Warum das heute Engpass ist</h2>
        <div set:html={bottleneckHtml} />
      </section>
    )}
  </Section>

  <Section surface="clay">
    {industry.requirements && industry.requirements.length > 0 && (
      <section>
        <h2>Anforderungen</h2>
        <dl class="req-list">
          {industry.requirements.map((r) => (
            <div class="req-row">
              <dt>{r.label}</dt>
              <dd>
                {r.value && <span class="val">{r.value}</span>}
                {r.notes && <span class="notes"> — {r.notes}</span>}
              </dd>
            </div>
          ))}
        </dl>
      </section>
    )}

    {alternativesHtml && (
      <section class="prose">
        <h2>Alternativen</h2>
        <div set:html={alternativesHtml} />
      </section>
    )}

    {solutionHtml && (
      <section class="prose">
        <h2>KRUPS-Lösung</h2>
        <div set:html={solutionHtml} />
      </section>
    )}

    {industry.recommendedProducts && industry.recommendedProducts.length > 0 && (
      <section>
        <h2>Empfohlene Systeme</h2>
        <div class="product-list">
          {industry.recommendedProducts.map((p: any) => (
            <a class="product-card" href={`/produkte/${p.productFamily?.slug?.current ?? ''}/${p.slug?.current ?? ''}`}>
              <h3>{p.name}</h3>
              {p.tagline && <p>{p.tagline}</p>}
            </a>
          ))}
        </div>
      </section>
    )}
  </Section>

  {industry.faq && industry.faq.length > 0 && (
    <Section surface="paper">
      <section>
        <h2>Häufige Fragen</h2>
        {industry.faq.map((q) => (
          <details class="faq-item">
            <summary>{q.question}</summary>
            <p>{q.answer}</p>
          </details>
        ))}
      </section>
    </Section>
  )}

  {industry.cta?.headline && (
    <Section surface="charcoal">
      <div class="cta-block">
        <h2>{industry.cta.headline}</h2>
        {industry.cta.description && <p class="cta-desc">{industry.cta.description}</p>}
        {industry.cta.buttonLabel && (
          <a href={industry.cta.buttonUrl ?? '/kontakt'} class="cta-btn">
            {industry.cta.buttonLabel} →
          </a>
        )}
      </div>
    </Section>
  )}
</BaseLayout>

<style>
  /* ── page hero ── */
  .page-hero {
    position: relative;
    min-height: 480px;
    background: var(--color-dark-bg);
    overflow: hidden;
  }
  .page-hero-inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--content-max);
    margin: 0 auto;
    padding: calc(var(--nav-height) + var(--space-16)) var(--space-16) var(--space-16);
    min-height: 480px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .page-hero-inner :global(.breadcrumbs ol) { color: var(--color-dark-muted); }
  .page-hero-inner :global(.breadcrumbs a) { color: var(--color-dark-muted); }
  .page-hero-inner :global(.breadcrumbs a:hover) { color: var(--color-dark-text); }
  .page-hero-inner :global(.breadcrumbs [aria-current='page']) { color: var(--color-dark-text); }
  .page-hero-text { max-width: 55%; margin-top: var(--space-5); }
  .page-hero-text h1 {
    font-family: var(--font-heading);
    font-size: clamp(40px, 4.5vw, 64px);
    font-weight: 600;
    line-height: 1.02;
    color: var(--color-dark-text);
    margin-bottom: var(--space-4);
  }
  .hero-lede {
    font-size: 17px;
    color: var(--color-dark-muted);
    line-height: 1.6;
    max-width: 46ch;
  }
  .page-hero-img {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 45%;
    z-index: 1;
  }
  .page-hero-img::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(90deg, var(--color-dark-bg) 0%, rgba(28,28,26,0.5) 50%, rgba(28,28,26,0) 100%);
  }
  .page-hero-img :global(.hero-photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  @media (max-width: 768px) {
    .page-hero { min-height: unset; }
    .page-hero-inner { min-height: unset; padding: calc(var(--nav-height) + var(--space-8)) var(--space-6) var(--space-8); }
    .page-hero-text { max-width: 100%; }
    .page-hero-img { position: static; width: 100%; height: 240px; }
    .page-hero-img::before { background: linear-gradient(180deg, rgba(28,28,26,0.4) 0%, rgba(28,28,26,0) 60%); }
  }
  .char-bar {
    list-style: none;
    padding: 24px 0;
    margin: 0 0 var(--space-12);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 24px;
  }
  .char-bar .lbl {
    display: block;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: var(--space-1);
  }
  .char-bar .val {
    display: block;
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-text);
  }
  h2 {
    font-family: var(--font-heading);
    font-size: var(--font-size-h2-section);
    font-weight: 500;
    margin: var(--space-10) 0 var(--space-4);
  }
  section:first-child h2 { margin-top: 0; }
  .prose :global(p) {
    max-width: 65ch;
    line-height: 1.7;
    color: var(--color-muted);
    margin-bottom: var(--space-4);
  }
  .req-list { border-top: 1px solid var(--color-border); }
  .req-row {
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 32px;
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .req-row dt {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.5px;
    font-weight: 500;
    color: var(--color-muted);
  }
  .req-row .val { color: var(--color-text); font-weight: 500; }
  .req-row .notes { color: var(--color-muted); }
  .product-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }
  .product-card {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 24px;
    color: var(--color-text);
    transition: border-color 220ms ease, transform 220ms ease, box-shadow 220ms ease;
  }
  .product-card:hover {
    border-color: rgba(232, 181, 0, 0.8);
    transform: translateY(-2px);
    box-shadow: 0 4px 24px rgba(26, 26, 24, 0.1);
  }
  .product-card h3 {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 500;
    margin-bottom: var(--space-2);
  }
  .product-card p {
    font-size: 14px;
    color: var(--color-muted);
    line-height: 1.6;
  }
  .faq-item { border-bottom: 1px solid var(--color-border); padding: var(--space-4) 0; }
  .faq-item summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 16px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item p { margin-top: var(--space-3); color: var(--color-muted); line-height: 1.65; max-width: 65ch; }
  .cta-block h2 { color: var(--color-dark-text); margin-top: 0; }
  .cta-desc {
    color: var(--color-dark-muted);
    line-height: 1.65;
    max-width: 540px;
    margin-bottom: var(--space-6);
  }
  .cta-btn {
    display: inline-block;
    padding: 13px 24px;
    background: var(--color-accent);
    color: var(--color-text);
    border-radius: var(--radius-md);
    font-size: 14px;
    font-weight: 600;
  }
  .cta-btn:hover { background: var(--color-accent-hover); }
  @media (max-width: 768px) {
    .req-row { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
