---
import { Font } from 'astro:assets';
import '../styles/tokens.css';
import '../styles/reset.css';
import '../styles/base.css';

import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import JsonLd from '../components/JsonLd.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { getSiteSettings, SITE_SETTINGS_FALLBACK, type Locale } from '../sanity/queries';
import {
  CANONICAL_URL,
  organizationSchema,
  websiteSchema,
  breadcrumbSchema,
  type Crumb,
} from '../lib/schema-org';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  /** Optional breadcrumb trail — emits a BreadcrumbList JSON-LD block. */
  breadcrumbs?: Crumb[];
  /** Additional JSON-LD entries for this page (Product, FAQPage, Article, etc). */
  jsonLd?: Array<Record<string, unknown>>;
  /** Path of the other-language version (e.g. '/en/about'). Emits hreflang only when set. */
  alternatePath?: string;
  /** Keep the page out of search indexes (drafts, previews). */
  noindex?: boolean;
}

const { title, description, locale = 'de', breadcrumbs, jsonLd, alternatePath, noindex } = Astro.props;

const fetched = await getSiteSettings(locale);
const settings = fetched ?? SITE_SETTINGS_FALLBACK[locale];
const metaDescription = description ?? settings.siteTagline ?? '';
const currentPath = Astro.url.pathname;
const canonicalUrl = `${CANONICAL_URL}${currentPath}`;
const ogLocale = locale === 'de' ? 'de_DE' : 'en_US';

const structuredData: Array<Record<string, unknown>> = [
  organizationSchema(),
  websiteSchema(locale),
];
if (breadcrumbs && breadcrumbs.length > 0) {
  structuredData.push(breadcrumbSchema(breadcrumbs));
}
if (jsonLd && jsonLd.length > 0) {
  structuredData.push(...jsonLd);
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {metaDescription && <meta name="description" content={metaDescription} />}
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonicalUrl} />}
    {alternatePath && !noindex && (
      <>
        <link rel="alternate" hreflang={locale} href={canonicalUrl} />
        <link rel="alternate" hreflang={locale === 'de' ? 'en' : 'de'} href={`${CANONICAL_URL}${alternatePath}`} />
        <link rel="alternate" hreflang="x-default" href={locale === 'de' ? canonicalUrl : `${CANONICAL_URL}${alternatePath}`} />
      </>
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="KRUPS Automation" />
    <meta property="og:title" content={title} />
    {metaDescription && <meta property="og:description" content={metaDescription} />}
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    {metaDescription && <meta name="twitter:description" content={metaDescription} />}

    <Font cssVariable="--font-oswald" preload />
    <Font cssVariable="--font-barlow" preload />
    <Font cssVariable="--font-jetbrains-mono" />

    <JsonLd data={structuredData} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <SiteHeader settings={settings} locale={locale} currentPath={currentPath} />
    <main id="main">
      <slot />
    </main>
    <SiteFooter settings={settings} locale={locale} />
    <CookieConsent />

    <script>
      // Gate the reveal CSS state so there's no FOUC before JS runs
      document.documentElement.classList.add('js-loaded');

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const observer = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          if (e.isIntersecting) {
            const el = e.target as HTMLElement;
            const delay = !reduceMotion && el.dataset.delay ? parseInt(el.dataset.delay) * 80 : 0;
            if (delay) el.style.transitionDelay = `${delay}ms`;
            el.classList.add('revealed');
            observer.unobserve(el);
          }
        }),
        { threshold: 0.06, rootMargin: '0px 0px -48px 0px' }
      );

      requestAnimationFrame(() => {
        document.querySelectorAll('[data-reveal]').forEach((el) => {
          // Elements already in the viewport on page load: reveal immediately, no animation
          if (el.getBoundingClientRect().top < window.innerHeight) {
            el.classList.add('revealed');
          } else {
            observer.observe(el);
          }
        });
      });
    </script>

    <style>
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--color-text);
        color: var(--color-bg);
        padding: var(--space-2) var(--space-4);
        z-index: 300;
      }

      .skip-link:focus {
        left: var(--space-4);
        top: var(--space-4);
      }

      main {
        min-height: 60vh;
      }
    </style>
  </body>
</html>
