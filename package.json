    "@sanity/image-url": "^2.1.1",
    "@sanity/preview-url-secret": "^4.0.5",
    "@sanity/vision": "^5.21.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.1.8",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "sanity": "^5.21.0",
